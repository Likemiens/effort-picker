    "url": "git+https://github.com/Likemiens/effort-picker.git"
  },
  "license": "MIT",
  "author": {
    "name": "Likemiens",
    "url": "https://github.com/Likemiens"
  },
  "type": "module",
  "main": "./effort-picker.js",
  "files": [
    "effort-picker.js",
    "effort-picker.d.ts",
    "effort-picker.css"
  ],
  "peerDependencies": {
    "react": ">=18"
